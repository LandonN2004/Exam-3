from PyQt5.QtWidgets import (
    QWidget, QLabel, QLineEdit, QPushButton,
    QVBoxLayout, QHBoxLayout, QGridLayout, QGroupBox
)
from matplotlib.backends.backend_qt5agg import FigureCanvasQTAgg as FigureCanvas
from matplotlib.figure import Figure


class TakeoffView(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Airplane Takeoff Calculator")

        self.weight_input = QLineEdit("56000")
        self.thrust_input = QLineEdit("13000")
        self.calculate_button = QPushButton("Calculate")

        input_box = QGroupBox("Input Data")
        input_layout = QGridLayout()

        input_layout.addWidget(QLabel("Weight (lb)"), 0, 0)
        input_layout.addWidget(self.weight_input, 0, 1)

        input_layout.addWidget(QLabel("Thrust (lb)"), 1, 0)
        input_layout.addWidget(self.thrust_input, 1, 1)

        input_layout.addWidget(self.calculate_button, 2, 1)

        input_box.setLayout(input_layout)

        self.vstall_label = QLabel("")
        self.vto_label = QLabel("")
        self.a_label = QLabel("")
        self.b_label = QLabel("")
        self.sto_label = QLabel("")

        results_box = QGroupBox("Calculated Results")
        results_layout = QGridLayout()

        results_layout.addWidget(QLabel("Vstall"), 0, 0)
        results_layout.addWidget(QLabel("="), 0, 1)
        results_layout.addWidget(self.vstall_label, 0, 2)

        results_layout.addWidget(QLabel("VTO"), 1, 0)
        results_layout.addWidget(QLabel("="), 1, 1)
        results_layout.addWidget(self.vto_label, 1, 2)

        results_layout.addWidget(QLabel("A"), 2, 0)
        results_layout.addWidget(QLabel("="), 2, 1)
        results_layout.addWidget(self.a_label, 2, 2)

        results_layout.addWidget(QLabel("B"), 3, 0)
        results_layout.addWidget(QLabel("="), 3, 1)
        results_layout.addWidget(self.b_label, 3, 2)

        results_layout.addWidget(QLabel("STO"), 4, 0)
        results_layout.addWidget(QLabel("="), 4, 1)
        results_layout.addWidget(self.sto_label, 4, 2)

        results_box.setLayout(results_layout)

        left_layout = QVBoxLayout()
        left_layout.addWidget(input_box)
        left_layout.addWidget(results_box)
        left_layout.addStretch()

        self.figure = Figure(figsize=(5.5, 4.5))
        self.canvas = FigureCanvas(self.figure)

        main_layout = QHBoxLayout()
        main_layout.addLayout(left_layout)
        main_layout.addWidget(self.canvas)

        self.setLayout(main_layout)
